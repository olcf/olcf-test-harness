#%Module

proc ModulesHelp { } {
   puts stderr "Sets up environment to use the OLCF Test Harness"
}

#---------------------------------------------
# Base path to test harness python scripts.  -
#---------------------------------------------
set harness_dir $env(OLCF_HARNESS_DIR)

#------------------------------------------------------
# Set path to harness driver programs, binaries, ...  -
#------------------------------------------------------
setenv PATH_TO_RGT_PACKAGE    $harness_dir/oth
prepend-path PATH             $harness_dir/bin
prepend-path PATH             $harness_dir/bin/compat
